{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FloodNet: Create Python environment",
            "type": "process",
            "command": "${env:USERPROFILE}\\miniforge3\\Scripts\\conda.exe",
            "args": [
                "env",
                "create",
                "-f",
                "environment.yml"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "FloodNet: Start local website",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\start_local_server.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "FloodNet: Stop local website",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\stop_local_server.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
